# Dependencies
node_modules/
/.pnp
.pnp.js

# Testing
/coverage

# Production
/dist
/build

# Build output for the double-click / portable variant.
# Rebuild with `npm run build:local`. Contains an inlined copy of the whole
# bundle plus a duplicate of the video, so it must never be committed.
/dist-local
/dist-single

# Local backup snapshots of the project (not part of the site).
/.backups/

# Large local media masters. The web delivery copy that the site actually
# loads lives in public/videos/ and IS committed — keep it under 100 MB,
# which is GitHub's hard per-file limit.
/media-masters/

# EdgeOne CLI state. .edgeone/anonymous.json holds a live deploy TOKEN and
# must never be committed. Written by `edgeone makers deploy`.
/.edgeone/

# Hand-rolled project archives (also far over GitHub's 100 MiB file limit).
/*.zip

# Local dev artifacts — raw downloads and Python caches are not for the site.
# The processed AVIF/WebP/JPG assets in public/images/ are tracked on purpose.
/tools/raw/
/tools/__pycache__/
/tools/old-manifest.json

# Portable-transfer helpers (run on each machine, not committed)
/make-portable.ps1
/run-portable.ps1
/wuzhen-portable.zip

# PPTX build helpers (the .pptx itself in public/assets/ IS committed)
/make_pptx.py
/.pptx_tmp/
/tools/make_pptx.py
/tools/make_pptx_v2.py
/tools/png3/
/tools/venv/
/tools/pptx_render/
/tools/*.pptx
/tools/*.bak
# transient render output from the PPTX build (regenerable)
/tools/_pptx_*/

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
